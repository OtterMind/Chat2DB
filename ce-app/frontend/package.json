{
  "name": "cutting-edge-frontend",
  "version": "0.9.10",
  "description": "Cutting Edge (CE) — AI-powered video clipping studio",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/updater.ts --bundle --platform=node --target=node18 --format=cjs --outdir=dist-electron --external:electron --external:electron-updater",
    "release": "npm run build && electron-builder --win nsis --publish always",
    "test:ui": "node scripts/ui-audit.mjs",
    "test:playback": "node scripts/playback-test.mjs",
    "check:bridge": "node scripts/check-bridge.mjs",
    "verify": "tsc --noEmit && node scripts/check-bridge.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@tanstack/react-query": "^5.51.0",
    "antd": "^5.19.0",
    "axios": "^1.7.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.4.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.1",
    "postcss": "^8.4.41",
    "puppeteer-core": "^23.9.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.cuttingedge.studio",
    "productName": "Cutting Edge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../build/backend",
        "to": "backend"
      },
      {
        "from": "../../build/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "yousefghorbanian98-create",
      "repo": "Chat2DB",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/icon.ico",
      "artifactName": "Cutting-Edge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Cutting Edge",
      "installerIcon": "build-assets/icon.ico",
      "uninstallerIcon": "build-assets/icon.ico",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false
    },
    "beforePack": "scripts/before-pack.js",
    "compression": "normal",
    "generateUpdatesFilesForAllChannels": true
  }
}
