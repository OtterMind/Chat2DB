{
  "name": "youtube-auto-uploader",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube Auto-Uploader & local AI Clipper",
  "main": "out/main/index.js",
  "author": "YouTube Auto-Uploader contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prebuild:win": "node scripts/fetch-binaries.mjs",
    "pack:win": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run prebuild:win && npm run pack:win",
    "smoke": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "smoke:binaries": "node scripts/smoke-binaries.mjs",
    "preview": "vite --config vite.preview.config.ts --host 0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.12",
    "axios": "^1.19.0",
    "better-sqlite3": "9.6.0",
    "electron-log": "5.4.2",
    "fluent-ffmpeg": "2.1.3",
    "google-auth-library": "9.15.1",
    "googleapis": "126.0.1",
    "keytar": "7.9.0",
    "lucide-react": "0.539.0",
    "node-cron": "3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "^6.30.4",
    "sharp": "^0.35.3",
    "sonner": "1.7.4",
    "yt-dlp-exec": "1.0.2",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/fluent-ffmpeg": "2.1.27",
    "@types/node": "20.19.10",
    "@types/node-cron": "3.0.11",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "electron-vite": "2.3.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "5.4.19",
    "vitest": "2.1.9"
  },
  "build": {
    "appId": "com.claudebuilt.youtubeuploader",
    "productName": "YouTube Auto-Uploader & AI Clipper",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/binaries",
        "to": "binaries"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "resources/music",
        "to": "music"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "YouTube Auto-Uploader ${version} ${arch}.${ext}",
      "electronLanguages": [
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "YouTube Auto-Uploader ${version} Portable.exe"
    }
  }
}
